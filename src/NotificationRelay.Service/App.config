<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Queue polling interval in milliseconds -->
    <add key="PollIntervalMs" value="1000" />
    <!-- Max retry attempts per message -->
    <add key="RetryCount" value="3" />
    <!-- Initial backoff delay in milliseconds (doubles each retry) -->
    <add key="RetryBackoffMs" value="200" />
    <!-- Directory for rolling log files -->
    <add key="LogDirectory" value="logs" />
  </appSettings>
</configuration>
