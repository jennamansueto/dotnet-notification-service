{
  "Relay": {
    "PollIntervalMs": 1000,
    "RetryCount": 3,
    "RetryBackoffMs": 200,
    "LogDirectory": "logs"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff ",
        "UseUtcTimestamp": true
      }
    }
  }
}
